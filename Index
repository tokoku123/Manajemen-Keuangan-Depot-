    <!-- JAVASCRIPT LOGIC (IN INDONESIAN) -->
    <script>
        // Storage Key & Initial Application State
        const STORAGE_KEY = 'AQUAFLOW_DEPOT_DATA_ID_V2';

        let appData = {
            currentRole: 'cashier',
            inventory: {
                filledGallons: 120,
                emptyGallons: 45,
                borrowedGallons: 35,
                caps: 450,
                tissues: 320,
                seals: 500
            },
            customers: [
                { id: 'c1', name: 'Kios Segar Barokah', phone: '081234567890', address: 'Blok A-02', balance: 60000, borrowedGallons: 10 },
                { id: 'c2', name: 'Ibu Rahma', phone: '081987654321', address: 'Jl. Mawar No. 45', balance: 18000, borrowedGallons: 3 },
                { id: 'c3', name: 'Warung Makan Sederhana', phone: '081456789012', address: 'Kawasan Ruko 10', balance: 0, borrowedGallons: 5 }
            ],
            transactions: [
                { id: 'tx-101', date: new Date().toISOString(), type: 'refill', itemDesc: 'Isi Ulang Galon', qty: 5, price: 6000, total: 30000, paymentMethod: 'cash', customerName: 'Pelanggan Umum' },
                { id: 'tx-102', date: new Date().toISOString(), type: 'new_gallon', itemDesc: 'Galon Baru + Isi', qty: 1, price: 55000, total: 55000, paymentMethod: 'qris', customerName: 'Ibu Rahma' },
                { id: 'tx-103', date: new Date().toISOString(), type: 'refill', itemDesc: 'Isi Ulang Galon', qty: 10, price: 6000, total: 60000, paymentMethod: 'tab', customerName: 'Kios Segar Barokah' }
            ],
            expenses: [
                { id: 'ex-201', date: new Date().toISOString(), category: 'Listrik & PLN', desc: 'Tagihan Listrik Depot Bulan Ini', loggedBy: 'Admin', amount: 250000 },
                { id: 'ex-202', date: new Date().toISOString(), category: 'Pembelian Air Tangki', desc: 'Air Baku Tangki Pegunungan 5.000L', loggedBy: 'Admin', amount: 350000 }
            ]
        };

        // Active Cart State
        let activeCart = {
            type: 'refill',
            title: 'Isi Ulang Galon',
            unitPrice: 6000,
            qty: 1,
            paymentMethod: 'cash',
            customerId: 'walkin'
        };

        let salesChartObj = null;
        let expenseChartObj = null;

        // Currency Formatter Helper
        function formatRupiah(number) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
        }

        // Initialization
        window.onload = function() {
            loadFromStorage();
            initCharts();
            applyRoleChange(appData.currentRole || 'cashier');
        };

        function saveToStorage() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
        }

        function loadFromStorage() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    appData = JSON.parse(saved);
                } catch(e) {
                    console.error('Gagal memuat data lokal', e);
                }
            }
        }

        function switchRole(role) {
            if (role === 'admin') {
                // Prompt password for admin access
                document.getElementById('adminPassInput').value = '';
                openModal('adminPasswordModal');
                setTimeout(() => document.getElementById('adminPassInput').focus(), 100);
                return;
            }
            applyRoleChange(role);
        }

        function verifyAdminPassword(e) {
            e.preventDefault();
            const input = document.getElementById('adminPassInput').value;
            if (input === '5546') {
                closeModal('adminPasswordModal');
                applyRoleChange('admin');
                showToast('Akses Pemilik Depot Berhasil!');
            } else {
                showToast('Password Salah! Gunakan kode 5546.', true);
                document.getElementById('adminPassInput').value = '';
            }
        }

        function applyRoleChange(role) {
            appData.currentRole = role;
            const cashierBtn = document.getElementById('roleCashierBtn');
            const adminBtn = document.getElementById('roleAdminBtn');
            const adminNavs = document.querySelectorAll('.admin-only');

            if (role === 'cashier') {
                cashierBtn.className = 'px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-white bg-aqua-600 shadow-sm';
                adminBtn.className = 'px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white bg-transparent';
                adminNavs.forEach(el => el.classList.add('hidden'));
                switchTab('pos');
                showToast('Beralih ke Mode Kasir POS');
            } else {
                adminBtn.className = 'px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-white bg-aqua-600 shadow-sm';
                cashierBtn.className = 'px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white bg-transparent';
                adminNavs.forEach(el => el.classList.remove('hidden'));
                switchTab('dashboard');
            }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-aqua-500', 'text-white');
                btn.classList.add('border-transparent');
            });

            const activeView = document.getElementById(`view-${tabId}`);
            if (activeView) activeView.classList.remove('hidden');

            const activeTabBtn = document.getElementById(`tab-${tabId}`);
            if (activeTabBtn) {
                activeTabBtn.classList.add('border-aqua-500', 'text-white');
                activeTabBtn.classList.remove('border-transparent');
            }

            if (tabId === 'dashboard') renderCharts();
            if (tabId === 'reports') renderPnLReport();
        }

        function showToast(msg, isError = false) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = msg;
            toastIcon.className = isError ? 'fa-solid fa-triangle-exclamation text-red-400 text-lg' : 'fa-solid fa-circle-check text-emerald-400 text-lg';

            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        function openModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('hidden');
            if (id === 'adjustGallonModal') {
                document.getElementById('adjFilled').value = appData.inventory.filledGallons;
                document.getElementById('adjEmpty').value = appData.inventory.emptyGallons;
            }
        }

        function closeModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('hidden');
        }

        /* POS TERMINAL ENGINE */
        function selectPosItem(type, title, price, el) {
            activeCart.type = type;
            activeCart.title = title;
            activeCart.unitPrice = price;

            // Remove active outline from all transaction cards
            document.querySelectorAll('.pos-item-card').forEach(card => {
                card.classList.remove('border-aqua-500', 'ring-2', 'ring-aqua-500', 'bg-aqua-50/40');
                card.classList.add('border-slate-100');
            });

            // Apply blue outline & light blue highlight to active selection
            const targetEl = el || document.getElementById(`pos-card-${type}`);
            if (targetEl) {
                targetEl.classList.remove('border-slate-100');
                targetEl.classList.add('border-aqua-500', 'ring-2', 'ring-aqua-500', 'bg-aqua-50/40');
            }

            document.getElementById('cartItemTitle').innerText = title;
            document.getElementById('cartUnitPrice').innerText = `${formatRupiah(price)} / unit`;
            calculatePosTotal();
        }

        function changePosQty(delta) {
            const input = document.getElementById('cartQtyInput');
            let current = parseInt(input.value) || 1;
            current += delta;
            if (current < 1) current = 1;
            input.value = current;
            calculatePosTotal();
        }

        function setPaymentMethod(method) {
            activeCart.paymentMethod = method;
            document.querySelectorAll('.pay-method-btn').forEach(btn => {
                btn.classList.remove('border-aqua-500', 'bg-aqua-50/50', 'text-aqua-700');
                btn.classList.add('border-slate-200', 'text-slate-600');
            });

            const activeBtn = document.getElementById(`payBtn-${method}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-slate-200', 'text-slate-600');
                activeBtn.classList.add('border-aqua-500', 'bg-aqua-50/50', 'text-aqua-700');
            }
        }

        function calculatePosTotal() {
            const qty = parseInt(document.getElementById('cartQtyInput').value) || 1;
            activeCart.qty = qty;
            const total = qty * activeCart.unitPrice;

            document.getElementById('cartCapDeduct').innerText = qty;
            document.getElementById('cartTissueDeduct').innerText = qty;
            document.getElementById('cartSubtotal').innerText = formatRupiah(total);
            document.getElementById('cartTotal').innerText = formatRupiah(total);
        }

        function updatePosCustomerInfo() {
            const select = document.getElementById('posCustomerSelect');
            const custId = select.value;
            activeCart.customerId = custId;

            const detailBox = document.getElementById('posCustomerDetail');
            if (custId === 'walkin') {
                detailBox.classList.add('hidden');
            } else {
                const customer = appData.customers.find(c => c.id === custId);
                if (customer) {
                    detailBox.classList.remove('hidden');
                    document.getElementById('posCustPhone').innerText = customer.phone;
                    document.getElementById('posCustTab').innerText = formatRupiah(customer.balance);
                    document.getElementById('posCustGallons').innerText = `${customer.borrowedGallons} unit`;
                }
            }
        }

        function resetCart() {
            document.getElementById('cartQtyInput').value = 1;
            setPaymentMethod('cash');
            selectPosItem('refill', 'Isi Ulang Galon', 6000);
        }

        function processCheckout() {
            const qty = activeCart.qty;
            const total = qty * activeCart.unitPrice;

            // Stock Check
            if (appData.inventory.filledGallons < qty && activeCart.type !== 'loan') {
                showToast('Stok Galon Isi tidak mencukupi!', true);
                return;
            }

            if (appData.inventory.caps < qty || appData.inventory.tissues < qty) {
                showToast('Peringatan: Stok tutup/tisu galon hampir habis!', true);
            }

            let customerName = 'Pelanggan Umum';
            if (activeCart.customerId !== 'walkin') {
                const customer = appData.customers.find(c => c.id === activeCart.customerId);
                if (customer) {
                    customerName = customer.name;
                    if (activeCart.paymentMethod === 'tab') {
                        customer.balance += total;
                    }
                    if (activeCart.type === 'loan') {
                        customer.borrowedGallons += qty;
                    }
                }
            } else if (activeCart.paymentMethod === 'tab') {
                showToast('Pilih pelanggan terdaftar untuk pembayaran Bon!', true);
                return;
            }

            // Deduct Stocks
            if (activeCart.type !== 'loan') {
                appData.inventory.filledGallons -= qty;
                appData.inventory.emptyGallons += qty;
            } else {
                appData.inventory.filledGallons -= qty;
                appData.inventory.borrowedGallons += qty;
            }

            appData.inventory.caps = Math.max(0, appData.inventory.caps - qty);
            appData.inventory.tissues = Math.max(0, appData.inventory.tissues - qty);

            // Record Transaction
            const newTx = {
                id: 'tx-' + Date.now().toString().slice(-5),
                date: new Date().toISOString(),
                type: activeCart.type,
                itemDesc: activeCart.title,
                qty: qty,
                price: activeCart.unitPrice,
                total: total,
                paymentMethod: activeCart.paymentMethod,
                customerName: customerName
            };

            appData.transactions.unshift(newTx);
            saveToStorage();
            renderAllViews();

            // Prepare Receipt Modal
            document.getElementById('recDateTime').innerText = new Date().toLocaleString('id-ID');
            document.getElementById('recCustomerName').innerText = customerName;
            document.getElementById('recPaymentMethod').innerText = activeCart.paymentMethod.toUpperCase();
            document.getElementById('recItemDesc').innerText = `${qty}x ${activeCart.title}`;
            document.getElementById('recTotalAmt').innerText = formatRupiah(total);

            openModal('receiptModal');
            showToast('Transaksi berhasil diproses & dicatat!');
            resetCart();
        }

        function shareWhatsAppReceipt() {
            showToast('Struk berhasil disimulasikan ke WhatsApp pelanggan!');
        }

        function renderAllViews() {
            renderDashboard();
            renderCustomers();
            renderInventory();
            renderExpenses();
            populateCustomerDropdown();
        }

        function populateCustomerDropdown() {
            const select = document.getElementById('posCustomerSelect');
            let html = `<option value="walkin">Pelanggan Umum (Tunai Langsung)</option>`;
            appData.customers.forEach(c => {
                html += `<option value="${c.id}">${c.name} (${c.phone})</option>`;
            });
            select.innerHTML = html;
        }

        function renderDashboard() {
            const todayStr = new Date().toISOString().split('T')[0];
            const todayTxs = appData.transactions.filter(t => t.date.startsWith(todayStr));
            const todaySales = todayTxs.reduce((sum, t) => sum + t.total, 0);

            const monthStr = new Date().toISOString().slice(0, 7);
            const monthTxs = appData.transactions.filter(t => t.date.startsWith(monthStr));
            const monthSales = monthTxs.reduce((sum, t) => sum + t.total, 0);

            const totalReceivables = appData.customers.reduce((sum, c) => sum + c.balance, 0);

            document.getElementById('dashTodaySales').innerText = formatRupiah(todaySales);
            document.getElementById('dashTodayCount').innerText = `${todayTxs.length} transaksi`;
            document.getElementById('dashMonthSales').innerText = formatRupiah(monthSales);
            document.getElementById('dashReceivables').innerText = formatRupiah(totalReceivables);

            document.getElementById('dashFilledStock').innerText = appData.inventory.filledGallons;
            document.getElementById('dashEmptyStock').innerText = appData.inventory.emptyGallons;
            document.getElementById('dashBorrowedStock').innerText = appData.inventory.borrowedGallons;

            document.getElementById('tab-receivable-badge').innerText = appData.customers.filter(c => c.balance > 0).length;

            // Render Recent Sales Table
            const recentTbody = document.getElementById('dashRecentSales');
            let recentHtml = '';
            appData.transactions.slice(0, 5).forEach(tx => {
                const dateFormatted = new Date(tx.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const payBadgeClass = tx.paymentMethod === 'cash' ? 'bg-emerald-100 text-emerald-700' : (tx.paymentMethod === 'qris' ? 'bg-sky-100 text-sky-700' : 'bg-red-100 text-red-700');
                recentHtml += `
                    <tr>
                        <td class="p-2.5 font-medium text-slate-500">${dateFormatted}</td>
                        <td class="p-2.5 font-semibold text-slate-800">${tx.itemDesc}</td>
                        <td class="p-2.5 font-bold">${tx.qty}</td>
                        <td class="p-2.5"><span class="px-2 py-0.5 text-[10px] rounded-md font-bold uppercase ${payBadgeClass}">${tx.paymentMethod}</span></td>
                        <td class="p-2.5 text-right font-bold text-slate-900">${formatRupiah(tx.total)}</td>
                    </tr>
                `;
            });
            recentTbody.innerHTML = recentHtml || '<tr><td colspan="5" class="p-4 text-center text-slate-400">Belum ada transaksi recorded</td></tr>';

            // Consumables Widget
            const consumablesBox = document.getElementById('dashConsumablesList');
            consumablesBox.innerHTML = `
                <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl text-xs">
                    <span class="font-medium text-slate-700"><i class="fa-solid fa-plug text-sky-500 mr-2"></i>Tutup Galon</span>
                    <span class="font-bold text-slate-900">${appData.inventory.caps} pcs</span>
                </div>
                <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl text-xs">
                    <span class="font-medium text-slate-700"><i class="fa-solid fa-box-tissue text-amber-500 mr-2"></i>Tisu Sanitasi</span>
                    <span class="font-bold text-slate-900">${appData.inventory.tissues} pcs</span>
                </div>
            `;
        }

        function renderCustomers() {
            const tbody = document.getElementById('customerTableBody');
            let html = '';
            let sumBalance = 0;

            appData.customers.forEach(c => {
                sumBalance += c.balance;
                html += `
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="p-3.5 font-bold text-slate-900">${c.name}</td>
                        <td class="p-3.5 text-slate-500">${c.phone} <br><span class="text-[10px] text-slate-400">${c.address || ''}</span></td>
                        <td class="p-3.5 font-extrabold ${c.balance > 0 ? 'text-red-600' : 'text-slate-400'}">${formatRupiah(c.balance)}</td>
                        <td class="p-3.5 font-bold text-purple-700">${c.borrowedGallons} unit</td>
                        <td class="p-3.5 text-right space-x-1">
                            ${c.balance > 0 ? `<button onclick="openSettlementModal('${c.id}')" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold px-2.5 py-1 rounded-lg text-xs">Bayar Bon</button>` : '<span class="text-slate-300 text-[10px]">Lunas</span>'}
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html || '<tr><td colspan="5" class="p-4 text-center text-slate-400">Belum ada pelanggan terdaftar</td></tr>';
            document.getElementById('totalReceivableSum').innerText = formatRupiah(sumBalance);
        }

        function openSettlementModal(custId) {
            const customer = appData.customers.find(c => c.id === custId);
            if (!customer) return;

            document.getElementById('settleCustomerId').value = customer.id;
            document.getElementById('settleCustName').innerText = customer.name;
            document.getElementById('settleCustBalance').innerText = formatRupiah(customer.balance);
            document.getElementById('settleAmount').value = customer.balance;
            openModal('settlementModal');
        }

        function processSettlement(e) {
            e.preventDefault();
            const custId = document.getElementById('settleCustomerId').value;
            const amt = parseFloat(document.getElementById('settleAmount').value) || 0;
            const customer = appData.customers.find(c => c.id === custId);

            if (customer) {
                customer.balance = Math.max(0, customer.balance - amt);

                appData.transactions.unshift({
                    id: 'tx-' + Date.now().toString().slice(-5),
                    date: new Date().toISOString(),
                    type: 'settlement',
                    itemDesc: 'Pelunasan Bon Pelanggan',
                    qty: 1,
                    price: amt,
                    total: amt,
                    paymentMethod: 'cash',
                    customerName: customer.name
                });

                saveToStorage();
                renderAllViews();
                closeModal('settlementModal');
                showToast(`Dicatat pembayar bon ${formatRupiah(amt)} dari ${customer.name}`);
            }
        }

        function filterCustomers() {
            const query = document.getElementById('searchCustomerInput').value.toLowerCase();
            const rows = document.querySelectorAll('#customerTableBody tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        }

        function renderInventory() {
            document.getElementById('invFilledGallons').innerText = appData.inventory.filledGallons;
            document.getElementById('invEmptyGallons').innerText = appData.inventory.emptyGallons;
            document.getElementById('invBorrowedGallons').innerText = appData.inventory.borrowedGallons;

            const totalAssets = appData.inventory.filledGallons + appData.inventory.emptyGallons + appData.inventory.borrowedGallons;
            document.getElementById('invTotalGallonsAsset').innerText = `${totalAssets} unit total`;

            const list = document.getElementById('invConsumablesList');
            list.innerHTML = `
                <div class="p-3 bg-slate-50 rounded-xl flex justify-between items-center text-xs">
                    <span class="font-semibold text-slate-800">Tutup Galon</span>
                    <span class="font-extrabold text-slate-900">${appData.inventory.caps} pcs</span>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl flex justify-between items-center text-xs">
                    <span class="font-semibold text-slate-800">Tisu Sanitasi</span>
                    <span class="font-extrabold text-slate-900">${appData.inventory.tissues} pcs</span>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl flex justify-between items-center text-xs">
                    <span class="font-semibold text-slate-800">Segel Plastik</span>
                    <span class="font-extrabold text-slate-900">${appData.inventory.seals} pcs</span>
                </div>
            `;
        }

        function saveGallonAdjustment(e) {
            e.preventDefault();
            appData.inventory.filledGallons = parseInt(document.getElementById('adjFilled').value) || 0;
            appData.inventory.emptyGallons = parseInt(document.getElementById('adjEmpty').value) || 0;

            saveToStorage();
            renderAllViews();
            closeModal('adjustGallonModal');
            showToast('Audit stok galon fisik berhasil diperbarui!');
        }

        function saveConsumableRestock(e) {
            e.preventDefault();
            const key = document.getElementById('restockItemKey').value;
            const qty = parseInt(document.getElementById('restockQty').value) || 0;
            const cost = parseFloat(document.getElementById('restockCost').value) || 0;

            if (appData.inventory[key] !== undefined) {
                appData.inventory[key] += qty;
            }

            appData.expenses.unshift({
                id: 'ex-' + Date.now().toString().slice(-5),
                date: new Date().toISOString(),
                category: 'Restok Tutup & Tisu',
                desc: `Restok ${qty} pcs ${key}`,
                loggedBy: appData.currentRole === 'admin' ? 'Admin' : 'Kasir',
                amount: cost
            });

            saveToStorage();
            renderAllViews();
            closeModal('restockConsumableModal');
            showToast(`Berhasil merestock ${qty} pcs ${key}!`);
        }

        function renderExpenses() {
            const tbody = document.getElementById('expenseTableBody');
            let html = '';
            let sumExpense = 0;

            appData.expenses.forEach(ex => {
                sumExpense += ex.amount;
                const dateStr = new Date(ex.date).toLocaleDateString('id-ID') + ' ' + new Date(ex.date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                html += `
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="p-3.5 text-slate-500">${dateStr}</td>
                        <td class="p-3.5 font-bold text-slate-800"><span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded-md text-[10px]">${ex.category}</span></td>
                        <td class="p-3.5 text-slate-600">${ex.desc}</td>
                        <td class="p-3.5 text-slate-500 font-medium">${ex.loggedBy}</td>
                        <td class="p-3.5 text-right font-extrabold text-slate-900">${formatRupiah(ex.amount)}</td>
                    </tr>
                `;
            });

            tbody.innerHTML = html || '<tr><td colspan="5" class="p-4 text-center text-slate-400">Belum ada pengeluaran dicatat</td></tr>';
            document.getElementById('totalExpenseSum').innerText = formatRupiah(sumExpense);
        }

        function saveQuickExpense(e) {
            e.preventDefault();
            const cat = document.getElementById('expCategory').value;
            const desc = document.getElementById('expDesc').value;
            const amt = parseFloat(document.getElementById('expAmount').value) || 0;

            appData.expenses.unshift({
                id: 'ex-' + Date.now().toString().slice(-5),
                date: new Date().toISOString(),
                category: cat,
                desc: desc,
                loggedBy: appData.currentRole === 'admin' ? 'Admin' : 'Kasir',
                amount: amt
            });

            saveToStorage();
            renderAllViews();
            closeModal('quickExpenseModal');
            showToast('Pengeluaran berhasil dicatat!');
        }

        function saveBulkWaters(e) {
            e.preventDefault();
            const supplier = document.getElementById('waterSupplier').value;
            const volume = parseInt(document.getElementById('waterVolume').value) || 0;
            const cost = parseFloat(document.getElementById('waterCost').value) || 0;

            appData.expenses.unshift({
                id: 'ex-' + Date.now().toString().slice(-5),
                date: new Date().toISOString(),
                category: 'Pembelian Air Tangki',
                desc: `Air Baku Tangki ${volume}L dari ${supplier}`,
                loggedBy: appData.currentRole === 'admin' ? 'Admin' : 'Kasir',
                amount: cost
            });

            saveToStorage();
            renderAllViews();
            closeModal('bulkWaterModal');
            showToast('Pengisian Air Tangki Baku berhasil dicatat!');
        }

        function saveCustomer(e) {
            e.preventDefault();
            const name = document.getElementById('custName').value;
            const phone = document.getElementById('custPhone').value;
            const addr = document.getElementById('custAddress').value;

            const newCust = {
                id: 'c-' + Date.now().toString().slice(-5),
                name: name,
                phone: phone,
                address: addr,
                balance: 0,
                borrowedGallons: 0
            };

            appData.customers.push(newCust);
            saveToStorage();
            renderAllViews();
            closeModal('addCustomerModal');
            showToast(`Pelanggan ${name} berhasil ditambahkan`);
        }

        /* P&L REPORT GENERATOR */
        function renderPnLReport() {
            const filter = document.getElementById('reportMonthFilter').value;
            const monthStr = new Date().toISOString().slice(0, 7);

            let txs = appData.transactions;
            let exps = appData.expenses;

            if (filter === 'current') {
                txs = txs.filter(t => t.date.startsWith(monthStr));
                exps = exps.filter(e => e.date.startsWith(monthStr));
            }

            const refillSales = txs.filter(t => t.type === 'refill').reduce((sum, t) => sum + t.total, 0);
            const newGallonSales = txs.filter(t => t.type === 'new_gallon').reduce((sum, t) => sum + t.total, 0);
            const totalRevenue = txs.reduce((sum, t) => sum + t.total, 0);

            const bulkWaterCosts = exps.filter(e => e.category === 'Pembelian Air Tangki').reduce((sum, e) => sum + e.amount, 0);
            const consumableCosts = exps.filter(e => e.category === 'Restok Tutup & Tisu').reduce((sum, e) => sum + e.amount, 0);
            const totalCOGS = bulkWaterCosts + consumableCosts;

            const grossProfit = totalRevenue - totalCOGS;

            const opexItems = exps.filter(e => e.category !== 'Pembelian Air Tangki' && e.category !== 'Restok Tutup & Tisu');
            const totalOPEX = opexItems.reduce((sum, e) => sum + e.amount, 0);

            const netProfit = grossProfit - totalOPEX;

            document.getElementById('pnlGrossRevenue').innerText = formatRupiah(totalRevenue);
            document.getElementById('pnlRefillSales').innerText = formatRupiah(refillSales);
            document.getElementById('pnlNewGallonSales').innerText = formatRupiah(newGallonSales);

            document.getElementById('pnlTotalCOGS').innerText = `(${formatRupiah(totalCOGS)})`;
            document.getElementById('pnlWaterCost').innerText = formatRupiah(bulkWaterCosts);
            document.getElementById('pnlCapsCost').innerText = formatRupiah(consumableCosts);

            document.getElementById('pnlGrossProfit').innerText = formatRupiah(grossProfit);
            document.getElementById('pnlTotalOPEX').innerText = `(${formatRupiah(totalOPEX)})`;

            const opexListEl = document.getElementById('pnlOpexList');
            let opexCategoryMap = {};
            opexItems.forEach(e => {
                opexCategoryMap[e.category] = (opexCategoryMap[e.category] || 0) + e.amount;
            });

            let opexHtml = '';
            for (const [cat, amt] of Object.entries(opexCategoryMap)) {
                opexHtml += `
                    <div class="flex justify-between">
                        <span>${cat}</span>
                        <span>${formatRupiah(amt)}</span>
                    </div>
                `;
            }
            opexListEl.innerHTML = opexHtml || '<div class="text-slate-400">Tidak ada biaya operasional dicatat pada periode ini</div>';

            const netEl = document.getElementById('pnlNetProfit');
            netEl.innerText = formatRupiah(netProfit);
            netEl.parentElement.className = netProfit >= 0 ?
                'p-4 bg-emerald-500 text-white rounded-xl flex justify-between font-extrabold text-base shadow-lg shadow-emerald-500/20' :
                'p-4 bg-red-500 text-white rounded-xl flex justify-between font-extrabold text-base shadow-lg shadow-red-500/20';
        }

        /* CHART.JS RENDERER */
        function initCharts() {
            const ctxSales = document.getElementById('salesChart').getContext('2d');
            salesChartObj = new Chart(ctxSales, {
                type: 'line',
                data: {
                    labels: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'],
                    datasets: [
                        {
                            label: 'Penjualan (Rp)',
                            data: [120000, 180000, 150000, 210000, 270000, 320000, 250000],
                            borderColor: '#0284c7',
                            backgroundColor: 'rgba(2, 132, 199, 0.1)',
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Pengeluaran (Rp)',
                            data: [35000, 50000, 25000, 350000, 40000, 60000, 30000],
                            borderColor: '#ef4444',
                            borderDash: [5, 5],
                            fill: false,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            const ctxExpense = document.getElementById('expenseChart').getContext('2d');
            expenseChartObj = new Chart(ctxExpense, {
                type: 'doughnut',
                data: {
                    labels: ['Air Tangki Baku', 'Listrik PLN', 'Bensin Kurir', 'Perawatan UV/Filter'],
                    datasets: [{
                        data: [350000, 250000, 80000, 120000],
                        backgroundColor: ['#0284c7', '#f59e0b', '#10b981', '#8b5cf6']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        function renderCharts() {
            if (salesChartObj) salesChartObj.update();
            if (expenseChartObj) expenseChartObj.update();
        }
    </script>
</body>
</html>
