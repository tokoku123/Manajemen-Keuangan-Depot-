<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AquaFlow - Manajer Keuangan & Operasional Depot Air</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        aqua: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
        }
    </style>
</head>
<body class="h-full flex flex-col font-sans text-slate-800 antialiased selection:bg-aqua-500 selection:text-white">

    <!-- Top Navigation Bar -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                
                <!-- Modern Fixed Brand Logo & Business Title -->
                <div class="flex items-center space-x-3">
                    <div class="relative bg-gradient-to-tr from-cyan-600 via-blue-600 to-teal-400 p-2.5 rounded-2xl shadow-lg shadow-cyan-500/20 text-white flex items-center justify-center w-11 h-11 border border-cyan-400/30">
                        <!-- Custom Refilled Water Droplet & Gallon Vector Logo -->
                        <svg class="w-6 h-6 text-white drop-shadow-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2.25c-3.5 4.5-6.75 8.25-6.75 11.25a6.75 6.75 0 0013.5 0c0-3-3.25-6.75-6.75-11.25zM12 18.5a3 3 0 01-3-3"></path>
                        </svg>
                        <span class="absolute -top-0.5 -right-0.5 flex h-3 w-3">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3 w-3 bg-cyan-300"></span>
                        </span>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold tracking-wide flex items-center gap-2 text-white">
                            AquaFlow <span class="text-[10px] bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 px-2 py-0.5 rounded-full font-semibold uppercase tracking-wider">Depot Air</span>
                        </h1>
                        <p class="text-xs text-slate-400">Manajer Keuangan & Operasional Depot</p>
                    </div>
                </div>

                <!-- Mode/Role Selector & Quick Expense Button -->
                <div class="flex items-center space-x-3">
                    <div class="bg-slate-800 p-1 rounded-xl border border-slate-700 flex text-xs font-medium">
                        <button id="roleCashierBtn" onclick="switchRole('cashier')" class="px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white">
                            <i class="fa-solid fa-cash-register"></i>
                            <span class="hidden sm:inline">Mode Kasir</span>
                        </button>
                        <button id="roleAdminBtn" onclick="switchRole('admin')" class="px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-white bg-aqua-600 shadow-sm">
                            <i class="fa-solid fa-user-shield"></i>
                            <span class="hidden sm:inline">Pemilik Depot</span>
                        </button>
                    </div>

                    <!-- Quick Expense Button -->
                    <button onclick="openModal('quickExpenseModal')" class="bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 px-3 py-1.5 rounded-xl text-xs font-semibold flex items-center space-x-1.5 transition">
                        <i class="fa-solid fa-bolt text-amber-400"></i>
                        <span class="hidden md:inline">+ Pengeluaran Cepat</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Tab Navigation Bar -->
        <nav class="bg-slate-800 border-t border-slate-700/50 text-slate-300 text-sm overflow-x-auto custom-scrollbar">
            <div class="max-w-7xl mx-auto px-4 flex space-x-1 sm:space-x-3">
                <button onclick="switchTab('pos')" id="tab-pos" class="tab-btn py-3 px-3.5 font-medium flex items-center space-x-2 border-b-2 border-transparent hover:text-white transition whitespace-nowrap">
                    <i class="fa-solid fa-cash-register"></i>
                    <span>Kasir POS</span>
                </button>
                <button onclick="switchTab('dashboard')" id="tab-dashboard" class="tab-btn py-3 px-3.5 font-medium flex items-center space-x-2 border-b-2 border-aqua-500 text-white transition whitespace-nowrap">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Dasbor</span>
                </button>
                <button onclick="switchTab('receivables')" id="tab-receivables" class="tab-btn py-3 px-3.5 font-medium flex items-center space-x-2 border-b-2 border-transparent hover:text-white transition whitespace-nowrap">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    <span>Piutang & Bon</span>
                    <span id="tab-receivable-badge" class="ml-1 px-1.5 py-0.5 text-xs bg-red-500/20 text-red-300 rounded-full font-bold">0</span>
                </button>
                <button onclick="switchTab('inventory')" id="tab-inventory" class="tab-btn py-3 px-3.5 font-medium flex items-center space-x-2 border-b-2 border-transparent hover:text-white transition whitespace-nowrap">
                    <i class="fa-solid fa-cubes"></i>
                    <span>Stok Galon & Bahan</span>
                </button>
                <button onclick="switchTab('expenses')" id="tab-expenses" class="tab-btn py-3 px-3.5 font-medium flex items-center space-x-2 border-b-2 border-transparent hover:text-white transition whitespace-nowrap">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Pengeluaran</span>
                </button>
                <button onclick="switchTab('reports')" id="tab-reports" class="tab-btn py-3 px-3.5 font-medium flex items-center space-x-2 border-b-2 border-transparent hover:text-white transition admin-only whitespace-nowrap">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    <span>Laporan Laba Rugi</span>
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

        <!-- Notification Toast Container -->
        <div id="toast" class="fixed bottom-5 right-5 z-50 transform transition-all duration-300 translate-y-20 opacity-0 pointer-events-none">
            <div id="toastContent" class="bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700 flex items-center space-x-3">
                <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
                <span id="toastMsg" class="text-sm font-medium">Tindakan berhasil disimpan</span>
            </div>
        </div>

        <!-- DASBOR UTAMA SECTION -->
        <section id="view-dashboard" class="tab-content space-y-6">
            <!-- Top Metric Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Penjualan Hari Ini -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between hover:shadow-md transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Penjualan Hari Ini</p>
                            <h3 id="dashTodaySales" class="text-2xl font-bold text-slate-900 mt-1">Rp 0</h3>
                        </div>
                        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
                            <i class="fa-solid fa-sack-dollar text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-3 text-xs text-slate-500 flex items-center gap-1">
                        <span id="dashTodayCount" class="font-semibold text-emerald-600">0 transaksi</span> hari ini
                    </div>
                </div>

                <!-- Pendapatan Bulanan -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between hover:shadow-md transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Omset Bulan Ini</p>
                            <h3 id="dashMonthSales" class="text-2xl font-bold text-slate-900 mt-1">Rp 0</h3>
                        </div>
                        <div class="p-3 bg-aqua-50 text-aqua-600 rounded-xl">
                            <i class="fa-solid fa-chart-line text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-3 text-xs text-slate-500">
                        Total penjualan tercatat bulan ini
                    </div>
                </div>

                <!-- Total Piutang (Bon) -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between hover:shadow-md transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Piutang (Bon)</p>
                            <h3 id="dashReceivables" class="text-2xl font-bold text-red-600 mt-1">Rp 0</h3>
                        </div>
                        <div class="p-3 bg-red-50 text-red-600 rounded-xl">
                            <i class="fa-solid fa-clock-rotate-left text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-3 text-xs text-slate-500">
                        Tagihan bon pelanggan belum lunas
                    </div>
                </div>

                <!-- Ringkasan Galon Fisik -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between hover:shadow-md transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Galon Siap Jual</p>
                            <h3 id="dashFilledStock" class="text-2xl font-bold text-slate-900 mt-1">0</h3>
                        </div>
                        <div class="p-3 bg-blue-50 text-blue-600 rounded-xl">
                            <i class="fa-solid fa-bottle-water text-xl"></i>
                        </div>
                    </div>
                    <div class="mt-3 text-xs text-slate-500 flex justify-between">
                        <span>Kosong: <b id="dashEmptyStock">0</b></span>
                        <span>Dipinjam: <b id="dashBorrowedStock">0</b></span>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Daily Sales & Expenses Chart -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 lg:col-span-2">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-chart-area text-aqua-600"></i> Tren Arus Kas (7 Hari)
                        </h2>
                        <span class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-lg">Data Real-time</span>
                    </div>
                    <div class="h-64 relative">
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>

                <!-- Cost Distribution Chart -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-pie-chart text-purple-600"></i> Distribusi Pengeluaran
                        </h2>
                    </div>
                    <div class="h-64 relative flex items-center justify-center">
                        <canvas id="expenseChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Recent Activity & Consumables -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Recent Sales -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-emerald-600"></i> Transaksi Kasir Terakhir
                        </h2>
                        <button onclick="switchTab('pos')" class="text-xs font-semibold text-aqua-600 hover:underline">+ Transaksi Baru</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 text-slate-500 uppercase font-semibold">
                                <tr>
                                    <th class="p-2.5">Waktu</th>
                                    <th class="p-2.5">Produk</th>
                                    <th class="p-2.5">Qty</th>
                                    <th class="p-2.5">Pembayaran</th>
                                    <th class="p-2.5 text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody id="dashRecentSales" class="divide-y divide-slate-100">
                                <!-- Dynamic -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Consumables Alert -->
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-box-open text-amber-500"></i> Stok Bahan Habis Pakai
                            </h2>
                            <button onclick="switchTab('inventory')" class="text-xs font-semibold text-aqua-600 hover:underline">Kelola Stok</button>
                        </div>
                        <div class="space-y-3" id="dashConsumablesList">
                            <!-- Dynamic -->
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 flex gap-2">
                        <button onclick="openModal('bulkWaterModal')" class="flex-1 bg-aqua-50 hover:bg-aqua-100 text-aqua-700 py-2.5 rounded-xl text-xs font-semibold text-center transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-truck-droplet"></i> Catat Air Tangki Baku
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- KASIR POS TERMINAL SECTION -->
        <section id="view-pos" class="tab-content hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left Column: Products & Customer Selection -->
                <div class="lg:col-span-7 space-y-6">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                        <h2 class="text-base font-bold text-slate-900 mb-3 flex items-center justify-between">
                            <span>Pilih Jenis Transaksi</span>
                            <span class="text-xs text-slate-400 font-normal"><i class="fa-solid fa-clock"></i> Transaksi Cepat &lt; 10 Detik</span>
                        </h2>

                        <!-- Product Grid -->
                        <div class="grid grid-cols-2 sm:grid-cols-2 gap-3" id="posProductGrid">
                            <!-- Item 1: Refill Only -->
                            <button id="pos-card-refill" onclick="selectPosItem('refill', 'Isi Ulang Galon', 6000, this)" class="pos-item-card text-left p-4 rounded-xl border-2 border-aqua-500 ring-2 ring-aqua-500 bg-aqua-50/40 hover:border-aqua-500 transition flex flex-col justify-between group">
                                <div class="flex justify-between items-start">
                                    <span class="p-2.5 bg-sky-100 text-sky-600 rounded-lg group-hover:scale-110 transition"><i class="fa-solid fa-arrows-rotate text-lg"></i></span>
                                    <span class="font-bold text-slate-900 text-sm sm:text-base">Rp 6.000</span>
                                </div>
                                <div class="mt-3">
                                    <h4 class="font-semibold text-slate-800 text-sm">Isi Ulang Saja</h4>
                                    <p class="text-xs text-slate-500 mt-0.5">Pelanggan membawa galon sendiri</p>
                                </div>
                            </button>

                            <!-- Item 2: Buy New Gallon + Refill -->
                            <button id="pos-card-new_gallon" onclick="selectPosItem('new_gallon', 'Galon Baru + Isi', 55000, this)" class="pos-item-card text-left p-4 rounded-xl border-2 border-slate-100 hover:border-aqua-500 transition flex flex-col justify-between group">
                                <div class="flex justify-between items-start">
                                    <span class="p-2.5 bg-emerald-100 text-emerald-600 rounded-lg group-hover:scale-110 transition"><i class="fa-solid fa-bottle-water text-lg"></i></span>
                                    <span class="font-bold text-slate-900 text-sm sm:text-base">Rp 55.000</span>
                                </div>
                                <div class="mt-3">
                                    <h4 class="font-semibold text-slate-800 text-sm">Galon Baru + Isi</h4>
                                    <p class="text-xs text-slate-500 mt-0.5">Beli galon fisik baru + isi ulang</p>
                                </div>
                            </button>

                            <!-- Item 3: Aqua Asli -->
                            <button id="pos-card-aqua_asli" onclick="selectPosItem('aqua_asli', 'Aqua Asli', 22000, this)" class="pos-item-card text-left p-4 rounded-xl border-2 border-slate-100 hover:border-aqua-500 transition flex flex-col justify-between group">
                                <div class="flex justify-between items-start">
                                    <span class="p-2.5 bg-blue-100 text-blue-600 rounded-lg group-hover:scale-110 transition"><i class="fa-solid fa-faucet-drip text-lg"></i></span>
                                    <span class="font-bold text-slate-900 text-sm sm:text-base">Rp 22.000</span>
                                </div>
                                <div class="mt-3">
                                    <h4 class="font-semibold text-slate-800 text-sm">Aqua Asli</h4>
                                    <p class="text-xs text-slate-500 mt-0.5">Air galon Aqua kemasan asli</p>
                                </div>
                            </button>

                            <!-- Item 4: Gallon Loan / Deposit -->
                            <button id="pos-card-loan" onclick="selectPosItem('loan', 'Pinjam Galon Depot', 0, this)" class="pos-item-card text-left p-4 rounded-xl border-2 border-slate-100 hover:border-aqua-500 transition flex flex-col justify-between group">
                                <div class="flex justify-between items-start">
                                    <span class="p-2.5 bg-amber-100 text-amber-600 rounded-lg group-hover:scale-110 transition"><i class="fa-solid fa-handshake text-lg"></i></span>
                                    <span class="font-bold text-slate-900 text-sm sm:text-base">Rp 0</span>
                                </div>
                                <div class="mt-3">
                                    <h4 class="font-semibold text-slate-800 text-sm">Pinjam Galon</h4>
                                    <p class="text-xs text-slate-500 mt-0.5">Catat peminjaman galon depot</p>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Customer Select -->
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80">
                        <div class="flex justify-between items-center mb-3">
                            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Profil Pelanggan</label>
                            <button onclick="openModal('addCustomerModal')" class="text-xs text-aqua-600 font-semibold hover:underline flex items-center gap-1">
                                <i class="fa-solid fa-user-plus"></i> + Pelanggan Baru
                            </button>
                        </div>
                        <select id="posCustomerSelect" onchange="updatePosCustomerInfo()" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-aqua-500">
                            <option value="walkin">Pelanggan Umum (Tunai Langsung)</option>
                            <!-- Dynamic options -->
                        </select>
                        <div id="posCustomerDetail" class="hidden mt-3 p-3 bg-slate-50 rounded-xl border border-slate-100 text-xs text-slate-600 flex justify-between">
                            <span>WhatsApp: <b id="posCustPhone">-</b></span>
                            <span>Sisa Bon: <b id="posCustTab" class="text-red-600">Rp 0</b></span>
                            <span>Galon Dipinjam: <b id="posCustGallons">0 unit</b></span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Cart & Payment Checkout -->
                <div class="lg:col-span-5">
                    <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200/80 sticky top-24 space-y-4">
                        <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                            <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
                                <i class="fa-solid fa-cart-shopping text-aqua-600"></i> Keranjang Transaksi
                            </h3>
                            <button onclick="resetCart()" class="text-xs text-red-500 font-medium hover:underline">Reset</button>
                        </div>

                        <!-- Selected Item Banner -->
                        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100">
                            <div class="flex justify-between items-center">
                                <span id="cartItemTitle" class="font-semibold text-slate-800 text-sm">Isi Ulang Galon</span>
                                <span id="cartUnitPrice" class="text-xs font-bold text-slate-500">Rp 6.000 / unit</span>
                            </div>

                            <!-- Quantity Counter -->
                            <div class="flex items-center justify-between mt-4">
                                <span class="text-xs font-medium text-slate-500">Jumlah (Galon)</span>
                                <div class="flex items-center space-x-2">
                                    <button onclick="changePosQty(-1)" class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-700 font-bold hover:bg-slate-100 active:scale-95 flex items-center justify-center">-</button>
                                    <input type="number" id="cartQtyInput" min="1" value="1" oninput="calculatePosTotal()" class="w-16 text-center border border-slate-200 rounded-lg py-1 font-bold text-slate-900 text-sm">
                                    <button onclick="changePosQty(1)" class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-700 font-bold hover:bg-slate-100 active:scale-95 flex items-center justify-center">+</button>
                                </div>
                            </div>
                        </div>

                        <!-- Auto Stock Deduction Note -->
                        <div class="p-3 bg-sky-50 rounded-xl text-sky-800 text-xs flex items-center gap-2">
                            <i class="fa-solid fa-circle-info text-sky-500"></i>
                            <span>Otomatis mengurangi <b id="cartCapDeduct">1</b> Tutup & <b id="cartTissueDeduct">1</b> Tisu.</span>
                        </div>

                        <!-- Payment Method Picker -->
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Metode Pembayaran</label>
                            <div class="grid grid-cols-3 gap-2">
